{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@lana/core": ["../core/src/index.ts"],
      "@lana/core/*": ["../core/src/*/index.ts"]
    }
  },
  "include": ["src", "test"]
}
