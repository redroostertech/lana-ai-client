# =============================================================================
# LanaAI Chef - Comprehensive .gitignore
# =============================================================================

# =============================================================================
# Node.js
# =============================================================================
node_modules/
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage & Testing
coverage/
*.lcov
.nyc_output/
lib-cov/

# Build output
dist/
out/

# Keep build/ folder for Electron assets (icons, entitlements)
# !build/

# =============================================================================
# Environment & Configuration
# =============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
.env.backup*

# Storage configuration (generated by external-storage.sh)
.storage-configured

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
.Python

# Distribution / packaging
*.egg
*.egg-info/
dist/
eggs/
.eggs/
lib/
lib64/
!cli/lib/
!cli/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Jupyter Notebook
.ipynb_checkpoints/

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =============================================================================
# IDEs & Editors
# =============================================================================
# VSCode / Cursor
.vscode/
.cursor/
*.code-workspace

# JetBrains (WebStorm, PyCharm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# Logs & Temporary Files
# =============================================================================
logs/
*.log
*.tmp
*.temp
*.bak
*.backup

# PM2
.pm2/

# =============================================================================
# Database & Storage
# =============================================================================
# Local database data (use external storage in production)
minio-data/
postgres-data/
pgdata/
*.sql.gz
*.dump

# SQLite
*.sqlite
*.sqlite3
*.db

# =============================================================================
# Onboarding & Customer Data
# =============================================================================
# Customer onboarding exports (activation codes, seed files)
exports/
seed-*.sql
!seed-test-data.sql

# =============================================================================
# Docker
# =============================================================================
docker-compose.override.yml
docker-compose.external-storage.override.yml
.docker/

# =============================================================================
# Security & Secrets
# =============================================================================
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# VPN configuration (contains sensitive keys and PSK)
vpn-discovery-config.json

# =============================================================================
# LaunchAgents (generated)
# =============================================================================
# These are generated by deploy scripts and stored in ~/Library/LaunchAgents
# Don't track generated plist files if accidentally copied here
*.plist
# But allow Electron build entitlements
!build/entitlements.mac.plist

# =============================================================================
# Backup files (generated by scripts)
# =============================================================================
*.backup-*
*.bak

# =============================================================================
# Test artifacts
# =============================================================================
test-results/
test-output/
playwright-report/
*.test.js.map

# API test artifacts
tests/.env.test
tests/newman-report.html
tests/*.html
tests/*.json

# =============================================================================
# Miscellaneous
# =============================================================================
# Lock files (keep package-lock.json but ignore others)
!package-lock.json
yarn.lock
pnpm-lock.yaml

# Compressed files
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Large binary files
*.model
*.bin
*.weights

unstructured-api/

# =============================================================================
# Electron
# =============================================================================
# Electron cache
.electron/

# Config backup (created during client builds)
public_html/js/config.js.backup

# Electron builder output (already covered by dist/)
dist-*/
# Electron bundle staging - regenerated by scripts/bundle-electron.js on every build
electron-dist/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm

# Claude Code local settings
.claude/

# =============================================================================
# Tiptap Bundle (generated)
# =============================================================================
# Tiptap bundle (generated from src/js/tiptap-bundle.js)
src/js/tiptap-bundle-built.js
src/js/tiptap-bundle-built.js.map

# =============================================================================
# Tailwind CSS (generated)
# =============================================================================
# Built by: npm run css:build
src/css/tailwind-output.css
build/screen-voice/
