<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LANA One hardened-runtime entitlements (mac.entitlements / mac.entitlementsInherit).

  LANA One bundles a whole native stack under Contents/Resources (Postgres +
  extensions, MinIO, llama-server, an embedding GGUF, and docling/unstructured
  Python 3.11 venvs). With mac.hardenedRuntime:true every one of those Mach-O
  binaries/dylibs/.so files must be Developer-ID signed (see
  scripts/afterpack-sign-resources.js), and several of them need runtime
  exceptions the default hardened-runtime profile denies. Each key below is a
  loosening of the hardened runtime, present ONLY because a bundled component
  needs it -- keep this list minimal and re-justify any addition.
-->
<plist version="1.0">
<dict>
    <!--
      allow-jit + allow-unsigned-executable-memory: llama.cpp's Metal/JIT
      backend (and any wasm/bytecode JIT in llama-server) allocates
      writable+executable memory pages at runtime. Hardened runtime blocks
      that (W^X) unless explicitly allowed. Without this, the local
      llama-server child process crashes on launch on Apple Silicon.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!--
      disable-library-validation: hardened runtime normally refuses to dlopen
      any dylib/.so that is not signed by the SAME Team ID as the host
      executable (or by Apple). The vendored Postgres dylibs (gettext, zstd,
      lz4, openssl@3, krb5, icu4c) and every Python C-extension .so in the
      docling/unstructured venvs are third-party, Developer-ID-signed by us
      as a courtesy (see afterpack-sign-resources.js), not signed by Apple or
      re-linked into our Team ID chain the way an Apple framework would be.
      Without this entitlement, postgres/python refuse to load their own
      extensions and the app fails to start the local stack.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
      allow-dyld-environment-variables: hardened runtime strips DYLD_* env
      vars (DYLD_LIBRARY_PATH, DYLD_FALLBACK_LIBRARY_PATH, etc.) before exec.
      The supervisor launches the relocated Postgres binaries and the Python
      venv interpreters with DYLD_LIBRARY_PATH pointed at the bundled
      lib/ directories (install_name_tool @executable_path rewrites cover the
      common case, but initdb/some extensions and the Python venvs still
      probe DYLD_* at process start). Without this, those child processes
      can fail to find their vendored dylibs even though the paths are
      correct on disk.
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!--
      network.client: the Node backend, llama-server, MinIO, and Postgres all
      make/accept loopback TCP connections; network.client covers outbound
      (also required for the app's own calls to one.lanaai.io for
      auth/billing/Forge relay).
    -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
      network.server: MinIO, llama-server, and the Node backend bind listening
      loopback ports (:9000/:9001, :8082/chat, :8090). Needed for the app (and
      its bundled child processes, which inherit the parent's code signature
      for sandboxing/TCC purposes in some configurations) to accept local
      connections.
    -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!--
      files.user-selected.read-write: user-initiated file open/save dialogs
      (document upload, export, etc.) in the renderer/main process.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
</content>
