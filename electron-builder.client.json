{
  "appId": "com.redroostertech.lana-ai-client",
  "productName": "Lana AI Client",
  "copyright": "Copyright © 2026 RedRooster Technologies Inc.",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "extraMetadata": {
    "main": "electron-main.js"
  },
  "artifactName": "LanaAI--genesis--${version}.${ext}",
  "publish": {
    "provider": "github",
    "owner": "redroostertech",
    "repo": "lana-ai-client",
    "releaseType": "release"
  },
  "files": [
    {
      "from": "public_html",
      "to": "public_html",
      "filter": ["**/*"]
    },
    {
      "from": "electron-dist",
      "to": ".",
      "filter": ["*.js", "package.json"]
    },
    {
      "from": "briefs/dist",
      "to": "briefs/dist",
      "filter": ["*.cjs"]
    },
    "node_modules/electron-store/**/*",
    "node_modules/conf/**/*",
    "node_modules/atomically/**/*",
    "node_modules/dot-prop/**/*",
    "node_modules/env-paths/**/*",
    "node_modules/json-schema-typed/**/*",
    "node_modules/ajv/**/*",
    "node_modules/ajv-formats/**/*",
    "node_modules/fast-deep-equal/**/*",
    "node_modules/json-schema-traverse/**/*",
    "node_modules/require-from-string/**/*",
    "node_modules/uri-js/**/*",
    "node_modules/semver/**/*",
    "node_modules/bonjour-service/**/*",
    "node_modules/multicast-dns/**/*",
    "node_modules/dns-packet/**/*",
    "node_modules/@leichtgewicht/ip-codec/**/*",
    "node_modules/thunky/**/*",
    "node_modules/sherpa-onnx-node/**/*",
    "node_modules/sherpa-onnx-*/**/*",
    "!**/{.DS_Store,.git,.hg,.svn,.gitignore,.gitattributes}",
    "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs}"
  ],
  "extraResources": [
    { "from": "docs/legal/THIRD_PARTY_NOTICES.md", "to": "licenses/THIRD_PARTY_NOTICES.md" },
    { "from": "docs/legal/sbom/lana-ai-client.cdx.json", "to": "licenses/sbom.cdx.json" },
    { "from": "node_modules/electron/dist/LICENSE", "to": "licenses/LICENSE.electron.txt" },
    { "from": "node_modules/electron/dist/LICENSES.chromium.html", "to": "licenses/LICENSES.chromium.html" }
  ],
  "protocols": [
    {
      "name": "Lana AI",
      "schemes": ["lana-ai"]
    }
  ],
  "beforePack": "scripts/before-pack.js",
  "asar": true,
  "asarUnpack": [
    "node_modules/sherpa-onnx-node/**/*",
    "node_modules/sherpa-onnx-*/**/*",
    "briefs/dist/briefs-transcription-worker.cjs"
  ],
  "npmRebuild": false,
  "mac": {
    "category": "public.app-category.business",
    "artifactName": "LanaAI--genesis--${version}-${arch}.${ext}",
    "target": ["dmg", "zip"],
    "icon": "build/icons/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": true,
    "binaries": [
      "Contents/Resources/screen-voice/lana-screen-voice",
      "Contents/Resources/briefs/LanaBleWake",
      "Contents/Resources/redactor/lana-redactor/lana-redactor"
    ],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "LANA uses the microphone when you dictate, talk with LANA, or record a meeting.",
      "NSBluetoothAlwaysUsageDescription": "LANA uses Bluetooth to let your paired phone know when this computer has something for it."
    },
    "extraResources": [
      {
        "from": "build/screen-voice/lana-screen-voice",
        "to": "screen-voice/lana-screen-voice"
      },
      {
        "from": "build/briefs/LanaBleWake",
        "to": "briefs/LanaBleWake"
      },
      {
        "from": "build/redactor/lana-redactor",
        "to": "redactor/lana-redactor"
      }
    ]
  },
  "win": {
    "artifactName": "LanaAI--genesis--${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icons/icon.ico",
    "extraResources": [
      {
        "from": "build/redactor/lana-redactor",
        "to": "redactor/lana-redactor"
      }
    ]
  },
  "linux": {
    "artifactName": "LanaAI--genesis--${version}.${ext}",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Office",
    "icon": "build/icons/",
    "extraResources": [
      {
        "from": "build/redactor/lana-redactor",
        "to": "redactor/lana-redactor"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lana AI Client",
    "artifactName": "LanaAI--genesis--${version}-setup.${ext}"
  },
  "dmg": {
    "artifactName": "LanaAI--genesis--${version}-${arch}.${ext}",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 400
    },
    "title": "Lana AI Client ${version}"
  }
}
